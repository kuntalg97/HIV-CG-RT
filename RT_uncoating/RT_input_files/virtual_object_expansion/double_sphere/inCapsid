# LAMMPS input
variable TEMP           equal   310.0
variable PRESS          equal   0.0
variable RUNTIME        equal   400000         # (10x1e6 timesteps)
variable RESTART        equal   10000             # frequency of writing restart file
#variable dumptrj        equal   ${RUNTIME}/1000
variable dumptrj        equal   10000
#variable SEED                  equal   12392
variable SEED2          equal   $( v_SEED + 1099 )
variable SEED3          equal   $( v_SEED + 80192 )
variable SEED4          equal   $( v_SEED + 7102 )
variable SEED5          equal   $( v_SEED + 30192 )
include                 "system.init"
#########               READ DATA FILE ######################
read_data               Capsid.data
# Read aligned coordinates from lammpstrj file (unwrapped coordinates)
read_dump               first_frame_aligned_y.lammpstrj 0 x y z box yes replace yes format native
include                 "Capsid_intra.ff"
include                 "Capsid_assembly.ff"
timestep                50.0                    #timestep of 50 fs
group                   Capsid type 1 92
neigh_modify            exclude molecule/intra Capsid
comm_style              tiled
comm_modify             mode single cutoff 70.0
compute                 1 Capsid pair gauss/wall
thermo                  10000
thermo_style            multi
thermo_modify           flush yes
fix                     m1 Capsid momentum 100000 linear 1 1 1 angular
fix                     b1 Capsid balance 100000 1.2 rcb

velocity                all create 310 ${SEED} mom yes rot yes dist gaussian
reset_timestep          0

##### Virtual object expansion
compute                 coreCOM all com
variable                R1 equal 10.0+0.002*step
variable                cx1 equal c_coreCOM[1]
variable                cy1 equal c_coreCOM[2]+100.0
variable                cz1 equal c_coreCOM[3]

variable                R2 equal 5.0+0.001*step
variable                cx2 equal c_coreCOM[1]
variable                cy2 equal c_coreCOM[2]+400.0
variable                cz2 equal c_coreCOM[3]
#####
velocity                all create 310 ${SEED} mom yes rot yes dist gaussian
reset_timestep          0
fix                     3 all nve
fix                     4 all langevin ${TEMP} ${TEMP} 500000.0 ${SEED3} zero yes
##### Initialize compute
compute_modify          coreCOM dynamic/dof yes
thermo_style            custom step temp c_coreCOM[1] c_coreCOM[2] c_coreCOM[3] v_R1 v_R2
run                     0
thermo_style            multi
##### Use fix indent for expanding spheres (pushes outward from inside)
fix                     push1 all indent 1.0 sphere v_cx1 v_cy1 v_cz1 v_R1 side out
fix                     push2 all indent 1.0 sphere v_cx2 v_cy2 v_cz2 v_R2 side out
#####
dump                    1 all custom ${dumptrj} Capsid.lammpstrj id mol type xs ys zs
dump_modify             1 sort id
restart                 ${RESTART} config.1 config.2
run                     ${RUNTIME}
write_data              eq0.data nocoeff
