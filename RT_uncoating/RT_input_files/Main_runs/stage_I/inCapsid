# LAMMPS input for capsid
variable TEMP		equal   310.0
variable PRESS 		equal   0.0
variable RUNTIME	equal   10000         # Short runs
#variable RESTART        equal   5000     # frequency of writing restart file
#variable dumptrj	equal	50000

#variable SEED  		equal  	12392
variable SEED2   	equal   $( v_SEED + 1099 )
variable SEED3  	equal   $( v_SEED + 80192 ) 
variable SEED4  	equal   $( v_SEED + 7102 )
variable SEED5 		equal   $( v_SEED + 30192 )

include 		"system.init"
	
#########		READ DATA FILE ######################
read_data               "start.data"  extra/bond/per/atom 20 extra/angle/per/atom 50  extra/special/per/atom 5000

include                 "Capsid_intra.ff"
include			"Capsid_assembly.ff"
include                 "RNP.ff"

timestep  		50.0 			#timestep of 50 fs

group			Capsid type <> 1 92
group			RNP type 93
group                   dNTP type 94

neigh_modify            exclude molecule/intra Capsid

comm_style 		tiled
comm_modify             mode single cutoff 70.0

compute                 1 Capsid pair gauss/wall
compute                 2 RNP pair lj/cut/soft

thermo       		10000
thermo_style            custom step spcpu temp ke pe etotal epair enthalpy c_1 c_2
thermo_modify           flush yes

fix                     m1 Capsid momentum 100000 linear 1 1 1 angular
fix                     b1 Capsid balance 100000 1.2 rcb

# Define the bond/create fix
# fix                   ID group-ID bond/create Nevery itype jtype Rmin bondtype iparam maxbond newtype                   prob  value  seed    atype  value
fix                     1  all      bond/create  10    97     94     20.0   521       iparam 1       95       jparam 1 96  prob  0.5    ${SEED2}   atype   3

fix                     2 all nve
fix 			3 all langevin ${TEMP} ${TEMP} 500000.0 ${SEED3} zero yes

#dump            	1 all custom ${dumptrj} Capsid.lammpstrj id mol type xs ys zs 
#dump_modify 		1 sort id

#restart                 ${RESTART} config.1 config.2
run 			${RUNTIME}

write_data              start.data nocoeff
write_dump              all atom dump1.lammpstrj
